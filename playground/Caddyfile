{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Hashed build files never change; the pages that load them do.
	@hashed path /assets/* *.wasm *.zip
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@pages path / /index.html /remote.html /sw.js
	header @pages Cache-Control "no-cache"

	# Any AnyPress dashboard address (including a seller's own) may embed it.
	header -X-Frame-Options

	file_server
}
