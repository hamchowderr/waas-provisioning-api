{
  "name": "waas-provisioning-api",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "create-key": "tsx src/cli/create-key.ts",
    "db-backup": "tsx src/cli/db-backup.ts",
    "typecheck": "tsc --noEmit && tsc -p sdk/typescript && tsc -p mcp",
    "test": "vitest run",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "sdk:generate": "openapi-typescript openapi/waas-provisioning-api.yaml -o sdk/typescript/src/generated/provisioning.ts --default-non-nullable false && openapi-typescript openapi/store-mail.yaml -o sdk/typescript/src/generated/store-mail.ts --default-non-nullable false && openapi-typescript openapi/webhooks.yaml -o sdk/typescript/src/generated/webhooks.ts --default-non-nullable false",
    "sdk:check": "openapi-typescript openapi/waas-provisioning-api.yaml -o sdk/typescript/src/generated/provisioning.ts --default-non-nullable false --check && openapi-typescript openapi/store-mail.yaml -o sdk/typescript/src/generated/store-mail.ts --default-non-nullable false --check && openapi-typescript openapi/webhooks.yaml -o sdk/typescript/src/generated/webhooks.ts --default-non-nullable false --check && tsc -p sdk/typescript",
    "mcp": "tsx --tsconfig mcp/tsconfig.json mcp/src/main.ts",
    "lint": "eslint .",
    "deadcode": "fallow dead-code"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.20",
    "@better-auth/mcp": "^1.7.20",
    "@better-auth/oauth-provider": "^1.7.18",
    "@gohighlevel/api-client": "3.1.1",
    "@googlemaps/places": "3.1.0",
    "@hono/node-server": "^2.1.6",
    "@mendable/firecrawl-js": "^4.52.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@namecom/core-api": "1.36.3",
    "@octokit/rest": "22.0.1",
    "@vercel/sdk": "1.28.61",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "aws4fetch": "1.0.20",
    "better-auth": "^1.7.18",
    "better-call": "^1.4.5",
    "hono": "^4.13.17",
    "kysely": "^0.29.8",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "stripe": "23.1.0",
    "tosend": "1.2.0",
    "tsx": "^4.23.15",
    "web-push": "3.6.7",
    "yaml": "^2.9.1",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@figma/rest-api-spec": "0.47.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/web-push": "3.6.4",
    "@types/yauzl": "3.4.0",
    "eslint": "^10.14.0",
    "fallow": "3.42.0",
    "jose": "^6.2.17",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "^14.0.4"
    }
  }
}
