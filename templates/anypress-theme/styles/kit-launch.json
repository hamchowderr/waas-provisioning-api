{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Launch (startup and software)",
	"slug": "kit-launch",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#1c6844",
					"name": "Brand",
					"slug": "primary"
				},
				{
					"color": "#dcefe3",
					"name": "Brand soft",
					"slug": "primary-accent"
				},
				{
					"color": "#cfe9d9",
					"name": "Second brand",
					"slug": "primary-alt"
				},
				{
					"color": "#13241a",
					"name": "Second brand deep",
					"slug": "primary-alt-accent"
				},
				{
					"color": "#121212",
					"name": "Text",
					"slug": "main"
				},
				{
					"color": "#d8d6cf",
					"name": "Text soft",
					"slug": "main-accent"
				},
				{
					"color": "#f4f3ef",
					"name": "Background",
					"slug": "base"
				},
				{
					"color": "#55534e",
					"name": "Muted text",
					"slug": "secondary"
				},
				{
					"color": "#e9e7e0",
					"name": "Tint",
					"slug": "tertiary"
				},
				{
					"color": "#d8d5cc",
					"name": "Border",
					"slug": "border-light"
				},
				{
					"color": "#2a2a28",
					"name": "Border on dark",
					"slug": "border-dark"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|schibsted-grotesk"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|schibsted-grotesk",
					"fontWeight": "800",
					"letterSpacing": "-0.035em",
					"lineHeight": "1"
				}
			},
			"button": {
				"border": {
					"radius": "var:preset|border-radius|sm"
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "var:preset|font-size|base",
					"fontFamily": "var:preset|font-family|schibsted-grotesk"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|schibsted-grotesk",
					"fontWeight": "800",
					"letterSpacing": "-0.03em"
				}
			},
			"core/image": {
				"border": {
					"radius": "0"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"width": "0"
					}
				},
				"spacing": {
					"padding": {
						"left": "0"
					}
				}
			}
		}
	}
}
