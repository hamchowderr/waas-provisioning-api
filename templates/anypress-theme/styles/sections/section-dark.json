{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"slug": "section-dark",
	"title": "Dark",
	"blockTypes": [
		"core/group",
		"core/columns",
		"core/column"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|main",
			"text": "var:preset|color|base"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "currentColor"
				}
			},
			"link": {
				"color": {
					"text": "currentColor"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|primary-alt"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary-alt",
					"text": "var:preset|color|primary-alt-accent"
				},
				":hover": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--primary-alt) 85%, var(--wp--preset--color--primary-alt-accent))",
						"text": "var:preset|color|primary-alt-accent"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var:preset|color|base",
						"style": "solid",
						"width": "var(--wp--custom--focus--width)",
						"offset": "var(--wp--custom--focus--offset)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|main-accent"
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "var:preset|color|border-dark"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "currentColor"
					}
				}
			},
			"core/details": {
				"border": {
					"bottom": {
						"color": "var:preset|color|border-dark"
					}
				}
			}
		}
	}
}