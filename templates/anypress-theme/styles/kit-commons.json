{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Commons (associations, chambers and churches)",
	"slug": "kit-commons",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#1f3a5f",
					"name": "Brand",
					"slug": "primary"
				},
				{
					"color": "#dce4ee",
					"name": "Brand soft",
					"slug": "primary-accent"
				},
				{
					"color": "#9c3d24",
					"name": "Second brand",
					"slug": "primary-alt"
				},
				{
					"color": "#fbf3ec",
					"name": "Second brand deep",
					"slug": "primary-alt-accent"
				},
				{
					"color": "#14202e",
					"name": "Text",
					"slug": "main"
				},
				{
					"color": "#d4dae2",
					"name": "Text soft",
					"slug": "main-accent"
				},
				{
					"color": "#f8f6f1",
					"name": "Background",
					"slug": "base"
				},
				{
					"color": "#4b5563",
					"name": "Muted text",
					"slug": "secondary"
				},
				{
					"color": "#eeeae0",
					"name": "Tint",
					"slug": "tertiary"
				},
				{
					"color": "#dcd6ca",
					"name": "Border",
					"slug": "border-light"
				},
				{
					"color": "#2a3a4e",
					"name": "Border on dark",
					"slug": "border-dark"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|public-sans"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|crimson-pro",
					"fontWeight": "600",
					"letterSpacing": "-0.005em",
					"lineHeight": "1.1"
				}
			},
			"button": {
				"border": {
					"radius": "var:preset|border-radius|xs"
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "var:preset|font-size|base",
					"fontFamily": "var:preset|font-family|public-sans"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|crimson-pro",
					"fontWeight": "700"
				}
			},
			"core/image": {
				"border": {
					"radius": "0"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"width": "0"
					}
				},
				"spacing": {
					"padding": {
						"left": "0"
					}
				}
			}
		}
	}
}
