{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Ridge (home services)",
	"slug": "kit-ridge",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#ad3209",
					"name": "Brand",
					"slug": "primary"
				},
				{
					"color": "#f6dccf",
					"name": "Brand soft",
					"slug": "primary-accent"
				},
				{
					"color": "#ffb000",
					"name": "Second brand",
					"slug": "primary-alt"
				},
				{
					"color": "#1a1205",
					"name": "Second brand deep",
					"slug": "primary-alt-accent"
				},
				{
					"color": "#111417",
					"name": "Text",
					"slug": "main"
				},
				{
					"color": "#d9d5cc",
					"name": "Text soft",
					"slug": "main-accent"
				},
				{
					"color": "#f1eee7",
					"name": "Background",
					"slug": "base"
				},
				{
					"color": "#41454a",
					"name": "Muted text",
					"slug": "secondary"
				},
				{
					"color": "#e6e1d6",
					"name": "Tint",
					"slug": "tertiary"
				},
				{
					"color": "#d6d0c3",
					"name": "Border",
					"slug": "border-light"
				},
				{
					"color": "#2c3035",
					"name": "Border on dark",
					"slug": "border-dark"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|public-sans"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|big-shoulders",
					"fontWeight": "800",
					"letterSpacing": "0",
					"lineHeight": "0.9",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"border": {
					"radius": "0"
				},
				"typography": {
					"fontWeight": "800",
					"fontSize": "var:preset|font-size|medium",
					"fontFamily": "var:preset|font-family|big-shoulders",
					"textTransform": "uppercase",
					"letterSpacing": "0.02em"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|big-shoulders",
					"fontWeight": "900",
					"textTransform": "uppercase"
				}
			},
			"core/image": {
				"border": {
					"radius": "0"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"width": "0"
					}
				},
				"spacing": {
					"padding": {
						"left": "0"
					}
				}
			}
		}
	}
}
