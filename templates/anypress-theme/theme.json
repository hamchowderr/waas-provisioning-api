		"custom": {
			"lineHeight": {
				"tight": 1.1,
				"snug": 1.25,
				"body": 1.6
			},
			"focus": {
				"width": "2px",
				"offset": "2px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|main"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|medium",
			"padding": {
				"left": "var:preset|spacing|medium",
				"right": "var:preset|spacing|medium"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|figtree",
			"fontSize": "var:preset|font-size|base",
			"lineHeight": "var(--wp--custom--line-height--body)",
			"fontWeight": "400"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|bricolage-grotesque",
					"fontWeight": "650",
					"lineHeight": "var(--wp--custom--line-height--tight)",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"lineHeight": "var(--wp--custom--line-height--snug)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "var(--wp--custom--line-height--snug)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|base"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"link": {
				"color": {
					"text": "currentColor"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|primary"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var:preset|color|primary",
						"style": "solid",
						"width": "var(--wp--custom--focus--width)",
						"offset": "var(--wp--custom--focus--offset)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|base"
				},
				"border": {
