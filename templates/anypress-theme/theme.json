{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"border": {
			"radiusSizes": [
				{
					"name": "None",
					"slug": "none",
					"size": "0"
				},
				{
					"name": "XS",
					"slug": "xs",
					"size": "0.25rem"
				},
				{
					"name": "Small",
					"slug": "sm",
					"size": "0.5rem"
				},
				{
					"name": "Medium",
					"slug": "md",
					"size": "0.75rem"
				},
				{
					"name": "Large",
					"slug": "lg",
					"size": "1.25rem"
				},
				{
					"name": "XL",
					"slug": "xl",
					"size": "2rem"
				},
				{
					"name": "2XL",
					"slug": "2-xl",
					"size": "3rem"
				},
				{
					"name": "Full",
					"slug": "full",
					"size": "100rem"
				}
			]
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"name": "Brand",
					"slug": "primary",
					"color": "#2747b8"
				},
				{
					"name": "Brand soft",
					"slug": "primary-accent",
					"color": "#e3e9fb"
				},
				{
					"name": "Second brand",
					"slug": "primary-alt",
					"color": "#f0b93a"
				},
				{
					"name": "Second brand deep",
					"slug": "primary-alt-accent",
					"color": "#4a3608"
				},
				{
					"name": "Text",
					"slug": "main",
					"color": "#15171c"
				},
				{
					"name": "Text soft",
					"slug": "main-accent",
					"color": "#d9dce3"
				},
				{
					"name": "Background",
					"slug": "base",
					"color": "#ffffff"
				},
				{
					"name": "Muted text",
					"slug": "secondary",
					"color": "#4b505c"
				},
				{
					"name": "Tint",
					"slug": "tertiary",
					"color": "#f4f5f7"
				},
				{
					"name": "Border",
					"slug": "border-light",
					"color": "#e1e4ea"
				},
				{
					"name": "Border on dark",
					"slug": "border-dark",
					"color": "#3a3e48"
				}
			],
			"gradients": [
				{
					"name": "Brand fade",
					"slug": "brand-fade",
					"gradient": "linear-gradient(160deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--main) 100%)"
				},
				{
					"name": "Tint fade",
					"slug": "tint-fade",
					"gradient": "linear-gradient(180deg, var(--wp--preset--color--tertiary) 0%, var(--wp--preset--color--base) 100%)"
				}
			]
		},
		"dimensions": {
			"dimensionSizes": [
				{
					"name": "Hero",
					"slug": "hero",
					"size": "min(85vh, 52rem)"
				},
				{
					"name": "Banner",
					"slug": "banner",
					"size": "28rem"
				},
				{
					"name": "Card",
					"slug": "card",
					"size": "20rem"
				}
			]
		},
		"layout": {
			"contentSize": "44rem",
			"wideSize": "80rem"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Small",
					"slug": "small-light",
					"shadow": "0 1px 2px rgba(15, 17, 22, 0.06), 0 1px 3px rgba(15, 17, 22, 0.08)"
				},
				{
					"name": "Medium",
					"slug": "medium-light",
					"shadow": "0 4px 10px rgba(15, 17, 22, 0.06), 0 12px 24px rgba(15, 17, 22, 0.06)"
				},
				{
					"name": "Large",
					"slug": "large-light",
					"shadow": "0 10px 20px rgba(15, 17, 22, 0.06), 0 30px 60px rgba(15, 17, 22, 0.10)"
				},
				{
					"name": "Lifted dark",
					"slug": "medium-dark",
					"shadow": "0 6px 14px rgba(15, 17, 22, 0.18), 0 18px 36px rgba(15, 17, 22, 0.16)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "clamp(.5rem, 2.5vw, 1rem)"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "clamp(1.5rem, 4vw, 2rem)"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "clamp(2rem, 5vw, 3rem)"
				},
				{
					"name": "Extra large",
					"slug": "x-large",
					"size": "clamp(3rem, 7vw, 5rem)"
				},
				{
					"name": "2XL",
					"slug": "xx-large",
					"size": "clamp(4rem, 9vw, 7rem)"
				},
				{
					"name": "3XL",
					"slug": "xxx-large",
					"size": "clamp(5rem, 12vw, 9rem)"
				},
				{
					"name": "4XL",
					"slug": "xxxx-large",
					"size": "clamp(6rem, 14vw, 13rem)"
				}
			],
			"units": [
				"rem",
				"em",
				"%",
				"vw",
				"vh",
				"px"
			],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
