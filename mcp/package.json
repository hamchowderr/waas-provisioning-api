{
  "name": "waas-provisioning-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an AI agent create and manage stores through the WaaS provisioning API",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamchowderr/waas-provisioning-api.git",
    "directory": "mcp"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "waas-provisioning-mcp": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/view && cp src/view/*.html src/view/*.css src/view/*.js dist/view/",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "waas-provisioning-sdk": "^0.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
