# Answers for install/anypress-install.sh. Copy to /root/anypress.env, fill in, then run the installer (or keep it
# next to the installer on your computer for "anypress-install.sh hostinger").
# The domains, admin email and bucket are required; leave the rest empty to skip what they turn on.

# Your own domain: the API answers on api.<this> and the dashboard on app.<this>.
ANYPRESS_BRAND_DOMAIN=example.com
# The domain customers' stores are named under (<name>.<this>). Use a separate domain from the brand
# domain if you can (see docs/self-hosting.md, BRAND_DOMAIN); the same domain works too.
ANYPRESS_STORE_DOMAIN=examplesites.com
# The platform admin: signs in to the dashboard and to Coolify.
ANYPRESS_ADMIN_EMAIL=you@example.com

# A Cloudflare API token with Zone:DNS:Edit on the zones of both domains. With it, the installer adds the
# five A records itself (DNS only). Empty: it prints them for you to add.
CLOUDFLARE_API_TOKEN=

# Coolify's admin password. Empty: one is generated and written to /root/anypress/credentials.env.
ANYPRESS_COOLIFY_PASSWORD=
# A Coolify API token (read, read:sensitive, write, deploy). Empty: the installer makes one itself.
COOLIFY_TOKEN=

# Required: a private bucket (Cloudflare R2 or any S3-compatible storage) for store templates, snapshots and
# backups, with a key that can read and write it (docs/self-hosting.md, section 3).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Email for stores and dashboard sign-in links (toSend). Without it, the dashboard has no sign-in.
STORE_SMTP_PASSWORD=
STORE_MAIL_FROM=
TOSEND_ADMIN_KEY=

# The name on a suspended store's page and in sign-in emails. Default: AnyPress.
STORE_BRAND_NAME=

# The storefront's address: <this>.<store domain>. Empty: its generated address under stores.<store domain>.
# You can add your own domain to it later from the dashboard (Change address).
ANYPRESS_STOREFRONT_SUBDOMAIN=

# Only for "anypress-install.sh hostinger", run on your computer. These stay on your computer.
# A Hostinger API token (hPanel → Account → API).
HOSTINGER_API_TOKEN=
# The VPS to set up. Empty: the one VPS in your account that isn't set up yet.
HOSTINGER_VPS_ID=
# Where a VPS that was never set up is placed, when Hostinger hasn't chosen one already.
HOSTINGER_DATA_CENTER_ID=
# yes: wipe a VPS that is already set up and install AnyPress on it.
HOSTINGER_RECREATE=

# Advanced: what to install.
ANYPRESS_COOLIFY_VERSION=4.4.6
ANYPRESS_API_REF=main
ANYPRESS_DASHBOARD_REF=main
# The store templates' release (a templates-v* tag). Empty: the newest. "off" in ANYPRESS_TEMPLATES skips the
# templates and the storefront.
ANYPRESS_TEMPLATES_REF=
ANYPRESS_TEMPLATES=on
