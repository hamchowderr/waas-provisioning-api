          "file": "templates/anypress-store/build.sh",
          "match": "BLOCKS_VERSION=\\$\\{BLOCKS_VERSION:-(?<version>[^}]+)\\}\\nBLOCKS_SHA256=\\$\\{BLOCKS_SHA256:-(?<sha>[0-9a-f]{64})\\}"
        },
        {
          "file": "templates/seller-storefront/build.sh",
