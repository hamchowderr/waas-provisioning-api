        {
          "file": "templates/anypress-store/README.md",
          "match": "Phone Bar, Location Finder and Age Check blocks \\((?<version>[0-9][^)]*)\\)"
        }
      ],
      "run": [
        "node templates/anypress-store/playground/blueprints.mjs"
      ]
    },
