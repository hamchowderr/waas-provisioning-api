{
  "$comment": "Every pinned version in this repository. The Update pins workflow moves them to the newest release; .github/pins/README.md explains the format.",
  "pins": [
    {
      "name": "AnyPress Client (store template)",
      "source": "github-tag:hamchowderr/waas-plugins",
      "tagPrefix": "anypress-client-v",
      "places": [
        {
          "file": "templates/anypress-store/CLIENT_VERSION",
          "match": "^(?<version>[0-9][^\\s]*)$"
        }
      ]
    },
    {
      "name": "AnyPress theme",
      "source": "github:hamchowderr/anypress-theme",
      "asset": "anypress.zip",
      "places": [
        {
          "file": "templates/anypress-store/theme.sh",
          "match": "THEME_VERSION=\\$\\{THEME_VERSION:-(?<version>[^}]+)\\}\\nTHEME_SHA256=\\$\\{THEME_SHA256:-(?<sha>[0-9a-f]{64})\\}"
        }
      ],
      "run": [
        "node templates/anypress-store/playground/blueprints.mjs"
      ]
    },
    {
      "name": "AnyPress Blocks",
      "source": "github:hamchowderr/anypress-blocks",
