{
  "name": "waas-provisioning-sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the WaaS Provisioning API: create and manage WordPress stores from your own code.",
  "keywords": [
    "wordpress",
    "waas",
    "website-as-a-service",
    "provisioning",
    "hosting",
    "sdk",
    "api-client",
    "typescript"
  ],
  "homepage": "https://github.com/hamchowderr/waas-provisioning-api/tree/main/sdk/typescript#readme",
  "bugs": {
    "url": "https://github.com/hamchowderr/waas-provisioning-api/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "Otaku Solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamchowderr/waas-provisioning-api.git",
    "directory": "sdk/typescript"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
