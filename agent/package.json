{
  "name": "anypress-site-assistant",
  "version": "0.1.0",
  "description": "The AnyPress website assistant: a Mastra agent that edits one website through the API's site tools",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/assistant.test.ts",
    "test:playground": "vitest run test/playground.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@mastra/core": "^1.80.0",
    "@mastra/mcp": "^2.6.0",
    "@mastra/memory": "^1.39.1",
    "@mastra/pg": "^1.33.0",
    "hono": "^4.13.14",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.47.0",
    "@mastra/libsql": "^1.27.1",
    "@types/node": "^22.20.5",
    "@wp-playground/cli": "^3.1.61",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
